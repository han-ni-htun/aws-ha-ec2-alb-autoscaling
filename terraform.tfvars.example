aws_region   = "ap-northeast-1"
aws_profile  = "your-aws-profile"
project_name = "aws-ha-ec2-alb-autoscaling"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "ap-northeast-1a",
  "ap-northeast-1c"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

dashboard_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

counting_subnet_cidrs = [
  "10.0.21.0/24",
  "10.0.22.0/24"
]

dashboard_instance_type = "t3.micro"
counting_instance_type  = "t3.micro"

dashboard_min_size         = 2
dashboard_desired_capacity = 2
dashboard_max_size         = 4

counting_min_size         = 2
counting_desired_capacity = 2
counting_max_size         = 4